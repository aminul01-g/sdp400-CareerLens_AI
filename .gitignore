# ---- Secrets & environment (fixes security finding S6) ----
.env
.env.*
!.env.example
*.pem
*.key
!*.pub

# ---- Local databases (legacy SQLite + any stray files) ----
*.db
*.sqlite
*.sqlite3
*.db-journal
# The predecessor Pathfinder database is deliberately archived, NOT dropped
# (plan T174). It is the one .db file that must be version-controlled so the
# "no data was migrated" decision stays auditable. See docs/archive/README.md.
!docs/archive/pathfinder-legacy.db

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
build/
dist/

# ---- Node / Next.js ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ---- Vercel ----
# The local project link and a full production build. Vercel rebuilds from
# the source, so committing 4 MB of build output buys nothing and risks a
# stale artefact being served.
frontend/.vercel/

# ---- Uploads (user CVs must never be committed) ----
uploads/
backend/uploads/

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- Test & coverage artefacts ----
playwright-report/
test-results/
.pytest_cache/

# ---- pgAdmin server config ----
pgadmin/
