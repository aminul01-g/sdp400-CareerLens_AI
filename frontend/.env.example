# CareerLens AI — frontend environment template
# Copy to `.env.local` and fill in the real API base URL:  cp .env.example .env.local
#
# NEXT_PUBLIC_* values are inlined at build time by Next.js, so the URL must be
# present when `npm run build` runs — setting it only at runtime will not work.
#
# This replaces the predecessor's `VITE_API_BASE_URL` and resolves the conflict
# between `.env` (port 5001) and `.env.development` (port 5000) by having exactly
# one variable, documented here, pointing at the backend's documented local port.

# Local development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Vercel). Set this in the project's environment variables.
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
