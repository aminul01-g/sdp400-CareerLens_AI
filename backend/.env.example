# =============================================================================
# CareerLens AI — backend environment template
# =============================================================================
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored (security finding S6). NEVER commit a filled-in copy.
# The API refuses to start if JWT_SECRET_KEY is missing or shorter than 32
# characters — that is a deliberate fail-fast (plan security finding S7), which
# replaces the legacy `JWT_SECRET_KEY = 'jwt-secret'` fallback.
# =============================================================================

# ---- Application ----
APP_NAME=careerlens-api
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api

# ---- Database (PostgreSQL 16) ----
# Matches the `postgres` service in docker-compose.yml.
# Production value: a managed instance URL, e.g. Neon/Render/Supabase.
DATABASE_URL=postgresql+psycopg://careerlens:careerlens_dev_password@localhost:5432/careerlens
# Separate database used by the pytest suite. Created by the test bootstrap.
TEST_DATABASE_URL=postgresql+psycopg://careerlens:careerlens_dev_password@localhost:5432/careerlens_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---- Authentication ----
# REQUIRED, minimum 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_-c_import_secrets_token_urlsafe_48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS ----
# Comma-separated allowlist. An unlisted Origin receives no
# Access-Control-Allow-Origin header (closes legacy finding S2, where the Flask
# app called CORS(app) with no allowlist at all).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- File uploads (CV processing) ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ---- Recommendation engine weights ----
# compatibility = SKILL_COVERAGE_WEIGHT * weighted_skill_coverage
#               + TFIDF_WEIGHT        * tfidf_cosine_similarity
# Defaults follow the proposal's "about 60% / 40%". Final values are chosen by
# the Phase 9 weight sweep against the 24 hand-labelled profiles; the sweep table
# is published in docs/evaluation_report.md.
SKILL_COVERAGE_WEIGHT=0.60
TFIDF_WEIGHT=0.40
ENGINE_VERSION=1.0.0

# ---- Optional LLM learning path (proposal 4.2: "core features work without it")
# ---- MUST stay false for the core system. When false, no key is required to ----
# ---- boot, and POST /api/skill-gap/{id}/learning-path returns 503.          ----
# Email (SMTP_HOST empty -> the message is written to MAIL_DIR)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Whether the SMTP server's certificate is verified. Leave this on: STARTTLS
# without verification is encrypted but unauthenticated, which looks secure
# and is not. Turn it off only for a server with a self-signed certificate.
SMTP_TLS_VERIFY=true
# A PEM bundle to trust instead of the system store, for a provider with a
# private certificate authority. Empty means the system store.
SMTP_CA_FILE=
MAIL_FROM=no-reply@careerlens.dev
MAIL_FROM_NAME=CareerLens AI
MAIL_TRANSPORT=file
MAIL_DIR=./mailbox
PUBLIC_BASE_URL=http://localhost:3000
# Whether an unconfirmed address may sign in. Off by default.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30

# Rate limiting. The counters live in the database, so the limit is shared by
# every worker and every replica rather than being per process.
#   postgres — the shared limit (production)
#   memory  — an in-process limit, for a single-process deployment
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=postgres
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_GENERATE_REQUESTS=30
RATE_LIMIT_GENERATE_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=300

# The networks whose X-Forwarded-For header may be believed, as a
# comma-separated list of CIDR blocks or bare addresses. Empty — the default —
# means believe none of them.
#
# X-Forwarded-For is client-supplied, and the rate limiter counts on the
# address it produces. A server that believed the header unconditionally
# would let any caller put a different address in front of every request,
# which is exactly what a rate limiter exists to prevent: the limit protects
# the password endpoints from guessing, and a forged header turns a
# 10-per-minute cap into an unlimited one.
#
# Behind a proxy (Render, Vercel, nginx), set this to the proxy's address or
# range, and the header will be believed. Left empty, every request is counted
# against the peer address — safe, and on a proxied deployment that means every
# request shares one bucket.
TRUSTED_PROXY_CIDRS=

LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20

# ---- Seed admin account (backend/scripts/seed_admin.py) ----
# Used only by the seed script, never by the running application.
#
# The domain must be one the API's own login validator accepts. A `.local`
# domain is reserved by RFC 6762 for mDNS and is rejected by `EmailStr`, so an
# admin seeded as `admin@careerlens.local` is created successfully here and
# then cannot log in. Use a real TLD.
ADMIN_EMAIL=admin@careerlens.dev
ADMIN_PASSWORD=ChangeMe_Admin#2026

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=false
